#!/bin/sh
#
# Check that a source archive (scripts/release-files) makes the gzip.exe
# beside it, by itself: unpack it in a new directory, run make there with
# downloads turned off (GZIP16_OFFLINE=1, so GNU's files must come from
# the archive's upstream/), and compare the gzip.exe it makes with this
# checkout's, byte for byte. A release carries the archive as gzip.exe's
# corresponding source, so it must be complete.
#
# usage: scripts/check-source ARCHIVE

set -eu

[ $# -eq 1 ] || { echo "usage: $0 ARCHIVE" >&2; exit 2; }
top=$(cd "$(dirname "$0")/.." && pwd)
archive=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
version=$(cat "$top/VERSION")

[ -f "$top/gzip.exe" ] || { echo "$0: no gzip.exe; run make" >&2; exit 1; }
work=$(mktemp -d "${TMPDIR:-/tmp}/gz16src.XXXXXX")
trap 'rm -rf "$work"' EXIT

tar -xzf "$archive" -C "$work"
tree=$work/gzip16-$version
[ -d "$tree" ] || { echo "$0: the archive has no gzip16-$version/" >&2; exit 1; }
GZIP16_OFFLINE=1 make -C "$tree" -s gzip.exe >/dev/null
GZIP16_OFFLINE=1 make -C "$tree" -s source >/dev/null
if cmp "$tree/gzip.exe" "$top/gzip.exe"; then
    echo "check-source: $(basename "$archive") makes gzip.exe ($(wc -c < "$top/gzip.exe") bytes), the same"
else
    echo "$0: gzip.exe from $(basename "$archive") differs" >&2
    exit 1
fi
